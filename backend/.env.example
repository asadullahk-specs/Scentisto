# ==========================================================
# SCENTISTO BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file with real secrets!
# ==========================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# CORS allow-list. In the standard Vercel deployment the storefront
# and this API share one domain (vercel.json rewrites /api/* to the
# function), so production browser traffic is same-origin and these
# are only needed for local development or a separate custom domain.
# Comma-separated values are accepted.
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
# PUBLIC_SITE_ORIGIN=https://www.scentisto.com

# Optional: opt THIS project's Vercel preview deployments into CORS.
# The previous code allowed every *.vercel.app origin, which let any
# site hosted on Vercel call this API from a browser.
# VERCEL_PREVIEW_ORIGIN_SUFFIX=-scentisto.vercel.app

# --- Database (MongoDB Atlas / Local) ---
MONGODB_URI=mongodb://localhost:27017/scentisto

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_a_secure_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=scentisto.com

# --- Password Policy ---
PASSWORD_MIN_LENGTH=10
BCRYPT_SALT_ROUNDS=12

# --- Account Lockout ---
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# --- Rate Limiting ---
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
ORDER_RATE_LIMIT_MAX=20

# --- Checkout / Shipping ---
FREE_SHIPPING_THRESHOLD=100
FLAT_SHIPPING_COST=10

# --- Cookies ---
COOKIE_SECRET=replace_with_a_secure_random_cookie_secret
