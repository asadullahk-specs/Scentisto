# ==========================================================
# SCENTISTO FRONTEND — ENVIRONMENT TEMPLATE
# ==========================================================
#
# Leave VITE_API_BASE_URL UNSET for both local development and for
# production. The app then calls the API at the relative path "/api",
# which works in both places:
#   - dev:  vite.config.js proxies /api -> http://localhost:5000
#   - prod: vercel.json rewrites /api/* -> the serverless function
#
# Only set it if you deploy the API on a genuinely different origin
# from the storefront. NEVER set it to a localhost URL in a file that
# is committed: Vite inlines this value at build time, so a localhost
# value here ships to every visitor and breaks production.
#
# VITE_API_BASE_URL=https://api.your-custom-domain.com/api

# Point the dev proxy somewhere other than localhost:5000 if needed.
# VITE_DEV_API_PROXY=http://localhost:5001
